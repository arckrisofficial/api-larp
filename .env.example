# -----------------------------------------------------------------------------
# APIGuard application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3002
NITROSTACK_PORT=3002
NITROSTACK_STUDIO_PORT=3000
NITROSTACK_WIDGET_PORT=3001
LOG_LEVEL=info
DEMO_SCENARIO=risky

# Optional asset overrides. Defaults are fixtures/ and demo-repositories/ locally,
# and dist/fixtures + dist/demo-repositories in production.
APIGUARD_FIXTURES_DIR=
APIGUARD_DEMO_REPOSITORIES_DIR=

# -----------------------------------------------------------------------------
# Consumer evidence
# -----------------------------------------------------------------------------
# false: committed, provenance-tagged fixture snapshot (reproducible demo)
# true: GitHub API against the configured allow-listed scope
USE_LIVE_GITHUB=false
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
DEMO_GITHUB_OWNER=YOUR_GITHUB_ORG_OR_USER
DEMO_GITHUB_REPOSITORIES=react-consumer,python-consumer,go-consumer
GITHUB_MAX_REQUESTS=40
GITHUB_MAX_MATCHES_PER_QUERY=2
GITHUB_CACHE_TTL_SECONDS=300

# Internal repository-scope registry. It is not mutable through a public MCP tool.
SCOPE_FILE_PATH=.apiguard/repository-scope.json
ALLOWED_GITHUB_OWNERS=
MAX_ACTIVE_REPOSITORIES=10

# -----------------------------------------------------------------------------
# Structured model gateway
# -----------------------------------------------------------------------------
# false: deterministic fixture/fallback mode; no external model key required
# true: use exactly one provider selected by LLM_PROVIDER
USE_LLM=false
LLM_PROVIDER=openai
LLM_TIMEOUT_MS=7000
LLM_MAX_EVIDENCE_ITEMS=8
LLM_MAX_SNIPPET_CHARS=1200

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# -----------------------------------------------------------------------------
# Consumer fix generation and draft pull requests
# -----------------------------------------------------------------------------
FIX_MAX_FILES=6
FIX_MAX_FILE_CHARS=24000
FIX_BRANCH_PREFIX=apiguard
FIX_PR_DRAFT=true

# GitHub writes are disabled unless BOTH this flag and an exact repository
# allow-list are configured. Tokens need contents:write and pull_requests:write.
APIGUARD_GITHUB_WRITE_ENABLED=false
APIGUARD_WRITABLE_REPOSITORIES=owner/repository

# -----------------------------------------------------------------------------
# Demo identity and deployed smoke test
# -----------------------------------------------------------------------------
# This is declared demo identity, not enterprise authentication.
DEMO_ACTOR_ID=judge-demo
DEMO_ACTOR_DISPLAY_NAME=Hackathon Judge

DEPLOYED_SERVICE_URL=
DEPLOYED_MCP_URL=
